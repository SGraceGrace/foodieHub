# ─────────────────────────────────────────────────────────────────────────────
# FoodieHub — environment variables template
#
# Copy this file to .env and fill in all required values.
# Lines marked REQUIRED must be set before the app will start.
# Lines marked OPTIONAL have safe defaults and can be left as-is for local dev.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Database — MySQL (user-service) ─────────────────────────────────────────
# docker-compose overrides these with local container addresses automatically.
# Fill these in only if you want to point at a remote DB (e.g. TiDB Cloud).
DB_URL=jdbc:mysql://localhost:3306/foodiehub
DB_USERNAME=root
DB_PASSWORD=root


# ─── Database — MongoDB (food-service, order-service, notification-service) ──
# docker-compose overrides this with the local container address automatically.
MONGODB_URI=mongodb://localhost:27017/foodiehub_food


# ─── Cache — Redis ────────────────────────────────────────────────────────────
# docker-compose overrides this with the local container address automatically.
REDIS_URL=redis://localhost:6379


# ─── Message broker — RabbitMQ ───────────────────────────────────────────────
# docker-compose overrides this with the local container address automatically.
RABBITMQ_URL=amqp://guest:guest@localhost:5672


# ─── Search — Elasticsearch (food-service) ───────────────────────────────────
# docker-compose overrides this with the local container address automatically.
ELASTICSEARCH_URI=http://localhost:9200


# ─── JWT  [REQUIRED] ─────────────────────────────────────────────────────────
# Use any long random string (min 32 chars) for JWT_KEY.
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=3600000
REFRESH_TOKEN_EXPIRATION=864000000


# ─── Google OAuth2  [REQUIRED for Google login] ──────────────────────────────
# Create credentials at https://console.cloud.google.com/
# Authorized redirect URI must include: http://localhost:8080/login/oauth2/code/google
GOOGLE-CLIENT-ID=your-google-client-id.apps.googleusercontent.com
GOOGLE-SECRET=your-google-client-secret


# ─── Email — notification-service  [REQUIRED for email alerts] ──────────────
# Use a Gmail address with an App Password (not your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password
ADMIN_EMAIL=your-gmail@gmail.com


# ─── Payment — Razorpay  [REQUIRED for checkout] ────────────────────────────
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret


# ─── Web Push — VAPID  [OPTIONAL — defaults are set in application.yaml] ─────
# Generate a new key pair: https://vapidkeys.com/
# Leave blank to use the built-in dev keys (fine for local testing).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=


# ─── Service URLs  [OPTIONAL — overridden by docker-compose automatically] ───
# These are only needed when running services outside of docker-compose.
USER_SERVICE_URL=http://localhost:8081
FOOD_SERVICE_URL=http://localhost:8082
ORDER_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084
GATEWAY_URL=http://localhost:8080
APP_URL=http://localhost:8081


# ─── Observability  [OPTIONAL] ───────────────────────────────────────────────
ZIPKIN_URL=http://localhost:9411
TRACING_SAMPLING_PROBABILITY=0.0
